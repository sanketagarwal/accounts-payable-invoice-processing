# The local fixture demo only needs an OpenAI API key.
INVOICE_READER_MODEL=openai/gpt-5.6-sol
OPENAI_API_KEY=
# MASTRA_DB_URL=file:/absolute/path/to/mastra.db
ACCOUNTING_PROVIDER=fixture
# Keep the credential-free demo on loopback. Configure auth before changing this.
MASTRA_HOST=127.0.0.1
# Optional for the loopback fixture demo; required outside that mode.
MASTRA_AUTH_TOKEN=
MASTRA_AUTH_USER_ID=
# Explicit demo-only fallback; replace with a real standalone screener in production.
SANCTIONS_SCREENING=

# Intuit QuickBooks MCP (only when ACCOUNTING_PROVIDER=quickbooks-mcp)
QBO_MCP_SERVER_PATH=
QBO_MCP_TOKEN_STORE_PATH=
# Posting is opt-in. Use QuickBooks internal account IDs, never account names.
QBO_MCP_ENABLE_POSTING=false
# Required acknowledgement when posting: run exactly one posting replica.
QBO_MCP_SINGLE_WRITER=false
# All processes on that replica must share this local lock directory.
QBO_MCP_POSTING_LOCK_DIR=./data/qbo-posting-locks
QBO_MCP_EXPENSE_ACCOUNT_ID=
QBO_MCP_TAX_ACCOUNT_ID=
QBO_MCP_AP_ACCOUNT_ID=
